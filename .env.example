# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 AI_API_KEY 값만 채우세요.
# .env.local 은 GitHub에 올라가지 않아요. (배포할 땐 Vercel 환경 변수에 같은 값을 넣어요)

# 학교 AI (SnowChat / Mindlogic FactChat 게이트웨이)
AI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
AI_MODEL=gemini-3.5-flash
AI_API_KEY=

# (다른 방법) Gemini 키를 직접 쓸 때 — 위 AI_ 값들을 비우고 이걸 채우세요
GEMINI_API_KEY=
GEMINI_MODEL=
